---

const { content } = Astro.props;
---

    <ol class="relative border-s border-gray-200 dark:border-gray-700 ml-2 sm:ml-4">
        {content.experience.map((item, index) => (
            <li class="ms-4 sm:ms-6 mb-8 sm:mb-10">
                <div class="absolute w-3 h-3 bg-gray-200 rounded-full mt-1.5 -start-1.5 border border-white dark:border-gray-900 dark:bg-gray-700"></div>
                <div class="pl-3 sm:pl-5">
                    <time class="mb-2 text-xs sm:text-sm font-normal block" data-i18n={`experience.${index}.date`}>{item.date}</time>
                    <h3 class="text-base sm:text-lg font-semibold mb-1" data-i18n={`experience.${index}.title`}>{item.title}</h3>
                    <p class="text-sm sm:text-base font-semibold italic mb-2 text-custom-blue" data-i18n={`experience.${index}.place`}>{item.place}</p>
                    <p class="text-sm sm:text-base font-normal leading-relaxed" data-i18n={`experience.${index}.description`}>
                        {item.description}
                    </p>
                </div>
            </li>
        ))}
    </ol>
