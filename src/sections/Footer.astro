---
const { content } = Astro.props;
---

<footer class="mt-8 sm:mt-12 py-6 sm:py-10">
  <div class="max-w-4xl items-center mx-auto text-center px-4">
    <p class="text-gray-400 text-sm sm:text-base">
      © {new Date().getFullYear()} Abel Haro Armero. <span data-i18n="footer">{content.footer}</span>
      · <a
        href="/llms.txt"
        target="_blank"
        rel="noreferrer"
        class="text-gray-400 hover:text-gray-600 transition-colors">llms.txt</a
      >
    </p>
  </div>
</footer>
