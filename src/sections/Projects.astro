---
const { content } = Astro.props;
const buttonClass =
  "focus-visible:border-ring focus-visible:ring-ring/50 rounded-none border border-border bg-background hover:bg-muted hover:text-foreground h-8 px-2.5 inline-flex items-center justify-center text-xs font-medium outline-none";
---

<div class="flex flex-col gap-12 sm:gap-14">
  {
    content.projects.map((project, index) => (
      <section class="flex flex-col">
        <header class="flex flex-col sm:flex-row gap-3 sm:gap-5 items-start sm:items-center mb-5 sm:mb-7">
          <h3
            class="text-xl sm:text-2xl lg:text-3xl font-bold"
            data-i18n={`projects.${index}.title`}
          >
            {project.title}
          </h3>
          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 w-full sm:w-auto">
            {project.url && (
              <a
                href={project.url}
                target="_blank"
                rel="noreferrer"
                class={buttonClass}
              >
                <img
                  src="/icons/github.svg"
                  alt={content.alt.github}
                  data-i18n-attr="alt:alt.github"
                  class="w-4 dark:invert mr-2"
                  loading="lazy"
                />
                <span data-i18n="actions.github">{content.actions.github}</span>
              </a>
            )}
            {project.productionUrl && (
              <a
                href={project.productionUrl}
                target="_blank"
                rel="noreferrer"
                class={buttonClass}
              >
                <img
                  src="/icons/link.svg"
                  alt={content.alt.externalLink}
                  data-i18n-attr="alt:alt.externalLink"
                  class="w-4 dark:invert mr-2"
                  loading="lazy"
                />
                <span data-i18n="actions.demo">{content.actions.demo}</span>
              </a>
            )}
          </div>
        </header>
        <p
          class="text-base sm:text-lg leading-relaxed mb-5 sm:mb-7"
          data-i18n={`projects.${index}.description`}
        >
          {project.description}
        </p>
        <div class="flex flex-row flex-wrap gap-2 sm:gap-3">
          {project.technologies.map((technology) => (
            <span class="flex items-center gap-2 rounded-full border border-border px-3 py-1 text-xs sm:text-sm bg-background/60">
              <img
                src={technology.source}
                alt={`${technology.name} icon`}
                class="size-4"
                loading="lazy"
              />
              <span>{technology.name}</span>
            </span>
          ))}
        </div>
      </section>
    ))
  }
</div>
