---
import ProjectCard from "@/components/ProjectCard.astro";
import type { PortfolioContent } from "@/data/portfolio";
const { content } = Astro.props as { content: PortfolioContent };
const order = [
  "links",
  "cpu",
  "tracking",
  "workflow",
  "network",
  "inspection",
  "sensors",
];
const featured = order.map((visual) => ({
  project: content.projects.find((project) => project.visual === visual)!,
  index: content.projects.findIndex((project) => project.visual === visual),
}));
const remaining = content.projects
  .map((project, index) => ({ project, index }))
  .filter(({ project }) => !order.includes(project.visual ?? ""));
---

<div class="bento-grid">
  {
    featured.map(({ project, index }, position) => (
      <ProjectCard
        project={project}
        index={index}
        content={content}
        wide={[0, 4, 5].includes(position)}
        full={project.visual === "tracking"}
      />
    ))
  }
</div>
<details class="more-projects">
  <summary
    ><span data-i18n="actions.moreProjects">{content.actions.moreProjects}</span
    ><span class="count">{remaining.length}</span></summary
  >
  <div class="more-grid">
    {
      remaining.map(({ project, index }) => (
        <ProjectCard project={project} index={index} content={content} />
      ))
    }
  </div>
</details>
<style>
  .bento-grid,
  .more-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }
  .more-projects {
    margin-top: 1.5rem;
  }
  .more-projects > summary {
    cursor: pointer;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 1rem;
  }
  .more-projects > summary:focus-visible {
    outline: 2px solid #569a89;
    outline-offset: 4px;
  }
  .count {
    margin-left: 0.75rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }
  .more-grid {
    padding-top: 1rem;
  }
  @media (min-width: 640px) {
    .bento-grid,
    .more-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
    }
  }
  @media (min-width: 900px) {
    .bento-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
